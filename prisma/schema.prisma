generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  userId String @id

  // Configuration and state
  birthday         UserBirthday?    @relation("UserBirthday")
  friendCodes      UserFriendCodes? @relation("UserFriendCodes")
  levels           Level[]
  levelsWeekly     WeeklyLevel[]
  levelsMonthly    MonthlyLevel[]
  reminders        Reminder[]
  // The timezone dates and times of reminders are in. Separate from the birthday's, which is only set to announce it on time
  reminderTimezone String?

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Something someone wants to be reminded of, which goes off once or again and again
model Reminder {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [userId], onDelete: Cascade)

  // What and when
  text     String
  dueAt    DateTime
  // When it first went off, which repeats count from, so a reminder on the 31st stays on the last day of shorter months
  startAt  DateTime
  repeat   ReminderRepeat?
  // The timezone it was set in, which repeats keep the time on the clock in
  timezone String

  // Where it goes: a DM, or the channel it was set in. Each falls back to the other
  delivery  ReminderDelivery
  channelId String?
  guildId   String?
  // The language it was set in, which it's sent in
  locale    String

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Indexes
  @@index([dueAt])
  @@index([userId])
}

enum ReminderRepeat {
  daily
  weekly
  monthly
  yearly
}

enum ReminderDelivery {
  dm
  channel
}

model UserBirthday {
  userId String @id
  User   User   @relation("UserBirthday", fields: [userId], references: [userId], onDelete: Cascade)

  // Configuration
  date                      DateTime
  timezone                  String?
  showAge                   Boolean  @default(false)
  announceInGuildsByDefault Boolean  @default(false)
  announceInGuildIds        String[] @default([])

  // State, so nothing is done twice or missed while the bot was offline
  roleYear      Int? // the year the birthday role was last given
  roleActive    Boolean @default(false) // whether the birthday role is on and has to be taken away after the birthday
  announcedYear Int? // the year the birthday was last announced

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Someone's friend codes for the games, shown to anyone who looks them up. The same in every server, as they belong to the person
model UserFriendCodes {
  userId String @id
  User   User   @relation("UserFriendCodes", fields: [userId], references: [userId], onDelete: Cascade)

  // The digits of each code, null while it isn't set
  nintendoSwitch String?
  pokemonGo      String?
  pokemonSleep   String?
  tcgPocket      String?

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Guild {
  guildId String @id

  // State
  leftAt DateTime? // when the bot was removed from the guild, after which its data is deleted unless the bot is added back

  // Switches for all role menus, all voice channels and all sticky messages at once. Each menu and join channel also has its own
  roleMenusEnabled Boolean @default(true)
  tempVoiceEnabled Boolean @default(true)
  stickiesEnabled  Boolean @default(true)
  // Switch for giveaways. While off, none can be started or entered, and running ones wait with their draw until it's back on
  giveawaysEnabled Boolean @default(true)

  // How many moderation cases the server has had, which numbers the next one. Never goes down, so deleted numbers aren't used again
  caseCount     Int @default(0)
  // How many giveaways the server has started, which numbers the next one, like cases
  giveawayCount Int @default(0)

  // Configuration
  counting          GuildCounting?      @relation("GuildCounting")
  birthday          GuildBirthday?      @relation("GuildBirthday")
  leveling          GuildLeveling?      @relation("GuildLeveling")
  logs              GuildLogs?          @relation("GuildLogs")
  starboard         GuildStarboard?     @relation("GuildStarboard")
  starboardEntries  StarboardEntry[]
  reactionRoleMenus ReactionRoleMenu[]
  tempVoiceCreators TempVoiceCreator[]
  tempVoiceChannels TempVoiceChannel[]
  tempVoiceSettings TempVoiceSettings[]
  stickyMessages    StickyMessage[]
  modCases          ModCase[]
  giveaways         Giveaway[]
  birthdayRoles     BirthdayRole[]
  levels            Level[]
  levelsWeekly      WeeklyLevel[]
  levelsMonthly     MonthlyLevel[]

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// A birthday role the bot gave, so exactly that role is taken away again, even if the birthday or the settings changed meanwhile
model BirthdayRole {
  guildId String
  guild   Guild  @relation(fields: [guildId], references: [guildId], onDelete: Cascade)
  userId  String
  roleId  String

  // Timestamps
  createdAt DateTime @default(now())

  @@id([guildId, userId])
}

model GuildBirthday {
  guildId String @id
  guild   Guild  @relation("GuildBirthday", fields: [guildId], references: [guildId], onDelete: Cascade)

  // Configuration
  enabled   Boolean @default(false)
  channelId String?
  roleId    String?

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Indexes
  @@unique([guildId, channelId])
}

model GuildCounting {
  guildId String @id
  Guild   Guild  @relation("GuildCounting", fields: [guildId], references: [guildId], onDelete: Cascade)

  // Configuration
  // Turned off, messages in the channel are left alone, and they aren't checked when it's turned back on
  enabled            Boolean @default(true)
  maxLives           Int? // lives per run, null for unlimited where wrong numbers are only removed. 1 resets on the first wrong number
  regenerateLives    Boolean @default(false) // whether milestones give back a life
  allowMath          Boolean @default(false)
  milestoneReactions Boolean @default(false)
  channelId          String

  // State
  livesLeft            Int       @default(0) // lives left in the current run, when maxLives is set
  lastCheckedMessageId String? // last message in the channel that was checked, valid or not. Syncing after downtime continues from here
  lastNumber           Int       @default(0) @map("currentNumber")
  lastNumberAt         DateTime? @map("currentNumberAt")
  lastNumberMessageId  String?   @map("currentNumberMessageId")
  lastNumberByUserId   String?   @map("currentNumberByUserId")

  // History
  highestNumber          Int       @default(0)
  highestNumberAt        DateTime?
  highestNumberByUserId  String?
  highestNumberMessageId String?

  // Relations
  runs  CountingRun[]
  users CountingUser[]

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Indexes
  @@index([channelId])
}

// One attempt at counting, from 1 until a wrong number resets it
model CountingRun {
  id      Int           @id @default(autoincrement())
  guildId String
  game    GuildCounting @relation(fields: [guildId], references: [guildId], onDelete: Cascade)

  // State
  startedAt     DateTime? // when 1 was counted, null for the run that was ongoing when tracking started
  endedAt       DateTime? // null while the run is ongoing
  endedByUserId String? // who sent the wrong number
  finalNumber   Int       @default(0) // the number reached, set when the run ends

  // Relations
  entries CountingEntry[]

  // Timestamps
  createdAt DateTime @default(now())

  // Indexes
  @@index([guildId, endedAt])
  @@index([endedByUserId])
}

// A milestone that was counted, like 100 or 250. Other numbers aren't kept, as they're never looked at
model CountingEntry {
  id      Int         @id @default(autoincrement())
  runId   Int
  run     CountingRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  guildId String

  number    Int
  userId    String
  messageId String
  countedAt DateTime

  // Indexes
  @@index([runId, number])
  // For finding and deleting someone's data
  @@index([userId])
}

// How a member did at counting in a guild
model CountingUser {
  guildId String
  game    GuildCounting @relation(fields: [guildId], references: [guildId], onDelete: Cascade)
  userId  String

  counted       Int       @default(0)
  mistakes      Int       @default(0)
  lastCountedAt DateTime?

  @@id([guildId, userId])
  @@index([guildId, counted])
  @@index([userId])
}

model ReactionRoleMenu {
  id String @id @default(cuid())

  // Configuration
  channelId       String
  // Null until the menu has roles and its message is posted
  messageId       String?
  // Only shown to admins, to tell menus apart. Menus from before names fall back to their title or roles
  name            String?
  // Null to use the default text
  title           String?
  description     String?
  enabled         Boolean  @default(true)
  singleChoice    Boolean  @default(false)
  requiredRoleIds String[] @default([])

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relation
  guildId String
  guild   Guild?         @relation(fields: [guildId], references: [guildId], onDelete: Cascade)
  roles   ReactionRole[]

  // Indexes
  @@index([guildId])
  // Looked up with every press of a role button
  @@index([messageId])
}

model ReactionRole {
  id String @id @default(cuid())

  // Configuration
  emoji  String
  roleId String

  // Relation
  menuId   String
  roleMenu ReactionRoleMenu @relation(fields: [menuId], references: [id], onDelete: Cascade)

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Indexes
  @@unique([menuId, roleId])
  @@index([menuId])
}

model GuildLeveling {
  guildId String @id
  guild   Guild  @relation("GuildLeveling", fields: [guildId], references: [guildId], onDelete: Cascade)

  // General
  enabled Boolean @default(false)
  // Whether being in voice earns XP too, besides chatting
  voiceXp Boolean @default(true)

  // Level ups
  // Whether level ups are announced. Members level up and get their rewards either way
  levelUpMessages  Boolean               @default(true)
  levelUpChannelId String?
  rewards          GuildLevelingReward[]
  multipliers      LevelingMultiplier[]

  // Winners
  // Where winners are announced. Without one, they aren't announced
  winnersChannelId String?

  // Weekly winner
  weeklyReward        String? // roleId of the weekly reward
  // Whether the weekly winner is announced. The reset and the role happen either way
  weeklyResetMessages Boolean   @default(true)
  weeklyLastResetAt   DateTime?
  weeklyLastWinner    String? // userId of the last weekly winner
  weeklyWinnerRole    String? // the role the last weekly winner got, which is taken away at the next reset even if the setting changed

  // Monthly winner
  monthlyReward        String? // roleId of the monthly reward
  // Whether the monthly winner is announced. The reset and the role happen either way
  monthlyResetMessages Boolean   @default(true)
  monthlyLastResetAt   DateTime?
  monthlyLastWinner    String? // userId of the last monthly winner
  monthlyWinnerRole    String? // the role the last monthly winner got, which is taken away at the next reset even if the setting changed

  // Filters
  ignoredChannels String[] @default([]) // messages here don't earn XP
  enabledChannels String[] @default([]) // only messages here earn XP, or anywhere when empty
  ignoredRoles    String[] @default([]) // members with any of these don't earn XP
  enabledRoles    String[] @default([]) // only members with one of these earn XP, or everyone when empty

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Indexes
  @@index([levelUpChannelId])
}

model GuildLevelingReward {
  id String @id @default(cuid())

  // Configuration
  level  Int
  roleId String

  // Relation
  guildId       String
  guildLeveling GuildLeveling @relation(fields: [guildId], references: [guildId], onDelete: Cascade)

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Indexes
  @@index([guildId])
}

model Level {
  // State
  xp Int @default(0)

  // Relation
  userId  String
  user    User   @relation(fields: [userId], references: [userId], onDelete: Cascade)
  guildId String
  guild   Guild  @relation(fields: [guildId], references: [guildId], onDelete: Cascade)

  // Timestamps
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@id([guildId, userId])
  // For the leaderboard and ranks, which go by XP
  @@index([guildId, xp])
  @@index([userId])
  @@map("UserLeveling")
}

model WeeklyLevel {
  // State
  xp Int @default(0)

  // Relation
  userId  String
  user    User   @relation(fields: [userId], references: [userId], onDelete: Cascade)
  guildId String
  guild   Guild  @relation(fields: [guildId], references: [guildId], onDelete: Cascade)

  // Timestamps
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@id([guildId, userId])
  // For the leaderboard and ranks, which go by XP
  @@index([guildId, xp])
  @@index([userId])
  @@map("UserLevelingWeekly")
}

model MonthlyLevel {
  // State
  xp Int @default(0)

  // Relation
  userId  String
  user    User   @relation(fields: [userId], references: [userId], onDelete: Cascade)
  guildId String
  guild   Guild  @relation(fields: [guildId], references: [guildId], onDelete: Cascade)

  // Timestamps
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@id([guildId, userId])
  // For the leaderboard and ranks, which go by XP
  @@index([guildId, xp])
  @@index([userId])
  @@map("UserLevelingMonthly")
}

// Multiplies the XP for messages in a channel or category, or from members with a role. Only the highest one that applies counts
model LevelingMultiplier {
  guildId       String
  guildLeveling GuildLeveling    @relation(fields: [guildId], references: [guildId], onDelete: Cascade)
  targetId      String // the channel, category or role
  type          MultiplierTarget
  multiplier    Float

  // Timestamps
  createdAt DateTime @default(now())

  @@id([guildId, targetId])
}

enum MultiplierTarget {
  channel
  role
}

// A join-to-create channel: joining it gives you a voice channel of your own, which is deleted once everyone has left
model TempVoiceCreator {
  id         String  @id @default(cuid())
  // The voice channel to join
  channelId  String  @unique
  // Where the new channels go. Null for the same category as the join channel
  categoryId String?
  // What the names of the new channels start with, so they look alike. Owners only name what comes after it
  namePrefix String  @default("")
  // Turned off, joining it does nothing, without losing its settings
  enabled    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  guildId  String
  guild    Guild              @relation(fields: [guildId], references: [guildId], onDelete: Cascade)
  channels TempVoiceChannel[]

  @@index([guildId])
}

// A voice channel someone got by joining a join-to-create channel. Its permissions are always worked out from this, never read back
model TempVoiceChannel {
  channelId      String   @id
  ownerId        String
  // The control panel in the channel's chat, edited as the channel changes
  panelMessageId String?
  // Kept from the join channel it was made with, which may be deleted or changed meanwhile
  namePrefix     String   @default("")
  locked         Boolean  @default(false)
  hidden         Boolean  @default(false)
  // Members let in even while it's locked or hidden
  allowed        String[] @default([])
  // Members who can't see or join it
  blocked        String[] @default([])
  // Members who help the owner: they let people in, keep them out, kick them and set the limit, and are always let in themselves
  moderators     String[] @default([])
  createdAt      DateTime @default(now())

  guildId   String
  guild     Guild             @relation(fields: [guildId], references: [guildId], onDelete: Cascade)
  creatorId String?
  creator   TempVoiceCreator? @relation(fields: [creatorId], references: [id], onDelete: SetNull)

  @@index([guildId, ownerId])
}

// How someone left their last voice channel on a server, so their next one there starts the same
model TempVoiceSettings {
  userId     String
  // What they call it, after the join channel's prefix. Null for their display name
  name       String?
  // 0 for no limit
  userLimit  Int      @default(0)
  locked     Boolean  @default(false)
  hidden     Boolean  @default(false)
  allowed    String[] @default([])
  blocked    String[] @default([])
  moderators String[] @default([])
  updatedAt  DateTime @updatedAt

  guildId String
  guild   Guild  @relation(fields: [guildId], references: [guildId], onDelete: Cascade)

  @@id([guildId, userId])
}

// Where a server's logs go, and which are turned off
model GuildLogs {
  guildId String @id
  guild   Guild  @relation("GuildLogs", fields: [guildId], references: [guildId], onDelete: Cascade)

  enabled             Boolean  @default(true)
  // Where groups without a channel of their own are logged. Null leaves them out
  defaultChannelId    String?
  // The channel of each group of logs. Null uses the default one
  messagesChannelId   String?
  membersChannelId    String?
  moderationChannelId String?
  serverChannelId     String?
  voiceChannelId      String?
  // The events turned off, so ones added later start turned on
  disabledEvents      String[] @default([])
  // Messages and voice in these channels, or in the channels of these categories, aren't logged
  ignoredChannelIds   String[] @default([])
  // Messages of members with any of these roles aren't logged
  ignoredRoleIds      String[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model GuildStarboard {
  guildId String @id
  guild   Guild  @relation("GuildStarboard", fields: [guildId], references: [guildId], onDelete: Cascade)

  enabled           Boolean  @default(true)
  // Where starred messages are posted. Nothing is posted without one
  channelId         String?
  // The emoji that stars a message, as sent to Discord. Null is ⭐
  emoji             String?
  // How many reactions it takes. Null is the default
  threshold         Int?
  // Reactions in these channels, or in the channels of these categories, don't count
  ignoredChannelIds String[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// A message someone starred, with who did, and its post once it has enough stars
model StarboardEntry {
  // The starred message
  messageId          String   @id
  guildId            String
  guild              Guild    @relation(fields: [guildId], references: [guildId], onDelete: Cascade)
  channelId          String
  authorId           String
  // The post on the starboard, null while it's below the threshold
  starboardMessageId String?  @unique
  // The channel the post is in, which stays its channel when the starboard moves to another one
  starboardChannelId String?
  // The names of the pictures uploaded with the post, as an update can only show those
  postImages         String[] @default([])
  // Who starred it, by reacting or with the button on the post. The author never counts
  starredBy          String[] @default([])
  // Deleted from the starboard by hand, so it isn't posted again
  removed            Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([guildId])
  @@index([authorId])
}

// A message the bot keeps at the bottom of a channel, by posting it again after others were sent
model StickyMessage {
  channelId String @id
  guildId   String
  guild     Guild  @relation(fields: [guildId], references: [guildId], onDelete: Cascade)

  text      String
  // The bot's latest post of it, which is deleted when it's posted again
  messageId String?

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([guildId])
}

// Something a moderator did to someone, like a warn or a ban, which together are their history on the server
model ModCase {
  id      String @id @default(cuid())
  guildId String
  guild   Guild  @relation(fields: [guildId], references: [guildId], onDelete: Cascade)
  // Counted per server, so people can talk about case 12
  number  Int

  type        ModCaseType
  // Who it's about, and who did it. Null when Discord's audit log didn't say
  userId      String
  moderatorId String?
  reason      String?

  // When a timeout or temporary ban runs out. Null for ones that don't
  expiresAt DateTime?
  // When a timeout or ban was ended before it ran out, like by an unban, a new ban, or a temporary ban being lifted
  endedAt   DateTime?

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([guildId, number])
  @@index([guildId, userId])
  @@index([expiresAt])
}

enum ModCaseType {
  warn
  timeout
  // A timeout taken away before it ran out
  untimeout
  kick
  ban
  unban
}

// A giveaway: a draft while it's being set up, then running until it ends and its winners are drawn
model Giveaway {
  id      String         @id @default(cuid())
  guildId String
  guild   Guild          @relation(fields: [guildId], references: [guildId], onDelete: Cascade)
  // Counted per server once it starts, so drafts don't use up numbers, and people can talk about giveaway 4
  number  Int?
  status  GiveawayStatus @default(draft)

  // Where it's posted, and who's hosting it
  channelId String
  // The post. Null for drafts, and once the post is gone
  messageId String? @unique
  hostId    String
  // The server's language when it started, which the post and the messages to winners are in
  locale    String

  // What's given away
  prize           String
  description     String?
  winnerCount     Int
  // How long it runs, counted from the start, as drafts haven't started yet
  durationMinutes Int
  endsAt          DateTime?
  endedAt         DateTime?

  // Who can enter, besides the required and blocked roles. Null for no limit
  // Whether all the required roles are needed, or any one of them
  requireAllRoles   Boolean @default(false)
  minLevel          Int?
  // How long someone has to be on the server, and how old their account has to be
  minMemberMinutes  Int?
  minAccountMinutes Int?

  // Winners
  // How long winners have to claim their prize before it goes to someone else. Null when they don't have to
  claimMinutes Int?
  // A role winners get, and a role pinged when it starts
  winnerRoleId String?
  pingRoleId   String?
  dmWinners    Boolean @default(true)

  roles   GiveawayRole[]
  entries GiveawayEntry[]
  winners GiveawayWinner[]

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([guildId, number])
  @@index([guildId, status])
  @@index([status, endsAt])
}

enum GiveawayStatus {
  draft
  active
  ended
  cancelled
}

// A role a giveaway asks for, keeps out, or gives bonus entries for
model GiveawayRole {
  giveawayId String
  giveaway   Giveaway         @relation(fields: [giveawayId], references: [id], onDelete: Cascade)
  roleId     String
  kind       GiveawayRoleKind
  // The extra entries, for bonus roles
  bonus      Int              @default(0)

  @@id([giveawayId, roleId])
  @@index([roleId])
}

enum GiveawayRoleKind {
  required
  blocked
  bonus
}

// Someone who entered a giveaway
model GiveawayEntry {
  giveawayId String
  giveaway   Giveaway @relation(fields: [giveawayId], references: [id], onDelete: Cascade)
  userId     String
  // Their chances: 1, plus the bonus of their roles. Kept up to date as their roles change, and worked out once more at the draw
  entries    Int      @default(1)

  // Timestamps
  createdAt DateTime @default(now())

  @@id([giveawayId, userId])
  // For the list of participants, sorted by entries
  @@index([giveawayId, entries])
  @@index([userId])
}

// Someone drawn as a winner. Winners who were replaced, like for not claiming in time, stay, so rerolls can be told apart
model GiveawayWinner {
  id         String   @id @default(cuid())
  giveawayId String
  giveaway   Giveaway @relation(fields: [giveawayId], references: [id], onDelete: Cascade)
  // Null once they deleted their data, so the giveaway still shows how many winners it had
  userId     String?

  drawnAt    DateTime  @default(now())
  // Until when they can claim their prize, and when they did. Null when claiming isn't needed
  claimBy    DateTime?
  claimedAt  DateTime?
  // When someone else was drawn in their place
  replacedAt DateTime?

  @@index([giveawayId])
  @@index([userId])
  @@index([claimBy])
}

// The bot's own profile: which theme its avatar and banner wear, so they're only uploaded again when the theme changes.
// A single row, with the id 1
model BotProfile {
  id Int @id @default(1)

  // The theme of the avatar and of the banner on Discord right now. Kept apart, as one can be uploaded while the other has to wait
  avatarTheme String?
  bannerTheme String?
  // A theme picked by hand with /dev, worn instead of the one of the day. Null to follow the calendar
  override    String?

  updatedAt DateTime @updatedAt
}

DISCORD_TOKEN="your_discord_token_here"
DISCORD_ID="your_discord_application_id_here"
# Server where developer commands like /dev are registered, only visible there
DEV_GUILD_ID="your_developer_server_id_here"

DATABASE_URL="postgresql://user:password@localhost:5432/your_database_name"

# Set to "on" for the bot to change its avatar and banner with the seasons and holidays by itself.
# Only on one copy of the bot, as two running with the same token would keep changing it back and forth
PROFILE_THEMES="off"
